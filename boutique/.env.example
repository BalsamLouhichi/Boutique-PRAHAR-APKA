# Copier ce fichier vers .env puis remplacer les valeurs avant docker compose up

DB_USER=postgres
DB_PASSWORD=change_this_strong_password
DB_NAME=boutique

# Generer une valeur aleatoire longue, par exemple : openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret

# Domaines autorises a appeler l'API, separes par des virgules
CORS_ORIGINS=https://votredomaine.com,http://localhost

# Port HTTP expose par le frontend/Nginx
HTTP_PORT=80
