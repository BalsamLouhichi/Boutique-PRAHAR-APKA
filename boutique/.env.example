# Copier ce fichier en ".env" à la racine et remplir les valeurs avant "docker compose up"

DB_USER=postgres
DB_PASSWORD=change_this_strong_password
DB_NAME=boutique

# Générer une valeur aléatoire longue, par ex: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret

# Domaine(s) autorisés à appeler l'API (séparés par des virgules)
CORS_ORIGINS=https://votredomaine.com

# Port HTTP exposé par le conteneur frontend/nginx
HTTP_PORT=80
