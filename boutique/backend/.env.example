NODE_ENV=production
PORT=4000

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_strong_password
DB_NAME=boutique

# Générer une valeur aléatoire longue: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret

CORS_ORIGINS=https://votredomaine.com,http://localhost:5173

# Mettre à true si la base PostgreSQL est distante et impose SSL (Neon, Supabase, etc.)
DB_SSL=false

# Emails des demandes et validations de comptes grossistes (optionnel en local)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=contact@votredomaine.com
