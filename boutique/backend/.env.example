NODE_ENV=production
PORT=4000

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_strong_password
DB_NAME=boutique

# Générer une valeur aléatoire longue: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret

CORS_ORIGINS=https://votredomaine.com,http://localhost:5173

# Stockage des images produits.
# - Laisser vide en local/Docker : les images sont écrites dans backend/uploads.
# - En production serverless (Vercel), créer un store Vercel Blob et coller ici
#   son jeton (Project > Storage > Blob). Sur Vercel il est injecté automatiquement
#   dès que le store est relié au projet.
BLOB_READ_WRITE_TOKEN=

# Emails des demandes et validations de comptes grossistes (optionnel en local)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=contact@votredomaine.com
